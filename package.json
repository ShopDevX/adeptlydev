{
  "name": "adeptly",
  "version": "0.5.1",
  "description": "Plan-first companion for Claude Code. Describe what to build — Adeptly drafts the plan with the right Claude Code features baked into each section. Free, open source, runs on your machine.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "planning",
    "developer-tools",
    "subagents",
    "cli"
  ],
  "homepage": "https://github.com/ShopDevX/adeptlydev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShopDevX/adeptlydev.git"
  },
  "license": "MIT",
  "author": "Jai (ShopDevX)",
  "bin": {
    "adeptly": "./bin/adeptly.js"
  },
  "files": [
    "bin/",
    ".next/standalone/",
    ".next/static/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:package": "next build && node scripts/pack-assets.js",
    "pack:assets": "node scripts/pack-assets.js",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build:package"
  },
  "dependencies": {
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.4.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
